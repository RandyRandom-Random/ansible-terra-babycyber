{
  "annotations": { "list": [] },
  "description": "Santé du serveur GitLab : VM (node_exporter) + application (/-/metrics).",
  "editable": true,
  "graphTooltip": 1,
  "id": null,
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "prometheus-soc" },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "options": { "0": { "color": "red", "index": 0, "text": "DOWN" } }, "type": "value" },
            { "options": { "1": { "color": "green", "index": 1, "text": "UP" } }, "type": "value" }
          ],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] }
        }
      },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "id": 1,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "horizontal",
        "reduceOptions": { "calcs": ["last"], "fields": "", "values": false },
        "textMode": "value_and_name"
      },
      "targets": [
        { "expr": "up{host=\"gitlab.infra.lan\"}", "legendFormat": "VM", "refId": "A" },
        { "expr": "up{job=\"gitlab-app\"}", "legendFormat": "App", "refId": "B" }
      ],
      "title": "GitLab health",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus-soc" },
      "fieldConfig": {
        "defaults": {
          "unit": "percent", "min": 0, "max": 100,
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 70 }, { "color": "red", "value": 90 }] }
        }
      },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "id": 2,
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "center",
        "orientation": "horizontal",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "value_and_name"
      },
      "targets": [
        { "expr": "100 - (avg(rate(node_cpu_seconds_total{host=\"gitlab.infra.lan\", mode=\"idle\"}[5m])) * 100)", "legendFormat": "CPU", "refId": "A" }
      ],
      "title": "CPU",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus-soc" },
      "fieldConfig": {
        "defaults": {
          "unit": "percent", "min": 0, "max": 100,
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 75 }, { "color": "red", "value": 90 }] }
        }
      },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "id": 3,
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "center",
        "orientation": "horizontal",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "value_and_name"
      },
      "targets": [
        { "expr": "(1 - (node_memory_MemAvailable_bytes{host=\"gitlab.infra.lan\"} / node_memory_MemTotal_bytes{host=\"gitlab.infra.lan\"})) * 100", "legendFormat": "RAM", "refId": "A" }
      ],
      "title": "Memory",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus-soc" },
      "fieldConfig": {
        "defaults": {
          "unit": "percent", "min": 0, "max": 100,
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 75 }, { "color": "red", "value": 90 }] }
        }
      },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "id": 4,
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "center",
        "orientation": "horizontal",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "value_and_name"
      },
      "targets": [
        { "expr": "100 - ((node_filesystem_avail_bytes{host=\"gitlab.infra.lan\", mountpoint=\"/\"} * 100) / node_filesystem_size_bytes{host=\"gitlab.infra.lan\", mountpoint=\"/\"})", "legendFormat": "Disk /", "refId": "A" }
      ],
      "title": "Disk /",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus-soc" },
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100 } },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "id": 5,
      "options": {
        "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "single" }
      },
      "targets": [
        { "expr": "100 - (avg(rate(node_cpu_seconds_total{host=\"gitlab.infra.lan\", mode=\"idle\"}[5m])) * 100)", "legendFormat": "CPU %", "refId": "A" },
        { "expr": "(1 - (node_memory_MemAvailable_bytes{host=\"gitlab.infra.lan\"} / node_memory_MemTotal_bytes{host=\"gitlab.infra.lan\"})) * 100", "legendFormat": "RAM %", "refId": "B" }
      ],
      "title": "CPU & RAM (timeseries)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus-soc" },
      "fieldConfig": { "defaults": { "unit": "Bps" } },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "id": 6,
      "options": {
        "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        { "expr": "rate(node_network_receive_bytes_total{host=\"gitlab.infra.lan\", device!~\"lo|docker.*|veth.*\"}[5m])", "legendFormat": "{{device}} rx", "refId": "A" },
        { "expr": "rate(node_network_transmit_bytes_total{host=\"gitlab.infra.lan\", device!~\"lo|docker.*|veth.*\"}[5m])", "legendFormat": "{{device}} tx", "refId": "B" }
      ],
      "title": "Network throughput",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus-soc" },
      "fieldConfig": { "defaults": { "unit": "reqps" } },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "id": 7,
      "options": {
        "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        { "expr": "sum by (status) (rate(http_requests_total{job=\"gitlab-app\"}[5m]))", "legendFormat": "HTTP {{status}}", "refId": "A" }
      ],
      "title": "HTTP requests (by status) — needs /-/metrics",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus-soc" },
      "fieldConfig": { "defaults": { "unit": "short" } },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "id": 8,
      "options": {
        "legend": { "calcs": ["last", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        { "expr": "sidekiq_running_jobs{job=\"gitlab-app\"}", "legendFormat": "running", "refId": "A" },
        { "expr": "sidekiq_queue_size{job=\"gitlab-app\"}", "legendFormat": "queue", "refId": "B" },
        { "expr": "sidekiq_dead_jobs{job=\"gitlab-app\"}", "legendFormat": "dead", "refId": "C" }
      ],
      "title": "Sidekiq jobs — needs /-/metrics",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus-soc" },
      "fieldConfig": { "defaults": { "unit": "short" } },
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 20 },
      "id": 9,
      "options": {
        "legend": { "calcs": ["last"], "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "single" }
      },
      "targets": [
        { "expr": "puma_active_connections{job=\"gitlab-app\"}", "legendFormat": "puma active", "refId": "A" },
        { "expr": "puma_workers{job=\"gitlab-app\"}", "legendFormat": "puma workers", "refId": "B" },
        { "expr": "puma_pool_capacity{job=\"gitlab-app\"}", "legendFormat": "puma pool", "refId": "C" }
      ],
      "title": "Puma workers — needs /-/metrics",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus-soc" },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 20 },
      "id": 10,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "center",
        "orientation": "horizontal",
        "reduceOptions": { "calcs": ["last"], "fields": "", "values": false },
        "textMode": "value_and_name"
      },
      "targets": [
        { "expr": "time() - node_boot_time_seconds{host=\"gitlab.infra.lan\"}", "legendFormat": "uptime", "refId": "A" }
      ],
      "title": "VM Uptime",
      "type": "stat"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["soc", "gitlab", "ci"],
  "templating": { "list": [] },
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "GitLab — Overview",
  "uid": "gitlab-overview",
  "version": 1
}
