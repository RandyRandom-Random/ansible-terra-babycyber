global:
  scrape_interval: 15s
  evaluation_interval: 15s

scrape_configs:
  - job_name: 'prometheus'
    static_configs:
      - targets: ['localhost:9090']

  # Node Exporter de TOUS les hôtes du groupe `node_exporters`.
  # Généré automatiquement depuis l'inventaire : chaque agent ajouté à
  # ce groupe apparaît dans le dashboard sans modifier ce fichier.
  - job_name: 'node'
    static_configs:
{% for host in groups['node_exporters'] | sort %}
      - targets: ['{{ hostvars[host].ansible_host }}:9100']
        labels:
          host: '{{ host }}'
{% endfor %}

{% if gitlab_app_enabled | bool %}
  # Métriques applicatives GitLab Omnibus (/-/metrics).
  # Pré-requis : /-/metrics activé + IP Prometheus ({{ prometheus_ip }})
  # dans la monitoring IP allowlist (Admin → Settings → Network).
  - job_name: 'gitlab-app'
    metrics_path: '/-/metrics'
    scheme: http
    static_configs:
      - targets: ['{{ gitlab_app_ip }}:80']
        labels:
          host: 'gitlab.infra.lan'
{% endif %}
